# Copy to .env and fill in. Never commit .env.
FLASK_DEBUG=1
MONGO_URI=mongodb://localhost:27017
MONGO_DB=samah_ayurveda
# Local development uses SQLite. Vercel automatically uses MongoDB for reservations.
BOOKING_STORAGE=sqlite
# Only needed when using SQLite on a host with a custom writable persistent path.
BOOKING_DB_PATH=data/appointment_slots.sqlite3
# Google Maps JavaScript API key (restrict it by HTTP referrer in Google Cloud Console).
# Leave empty to use the keyless embedded map fallback.
GOOGLE_MAPS_API_KEY=
# Clinic coordinates for the map marker (replace with the exact pin from Google Maps)
MAP_LAT=12.8830
MAP_LNG=74.8430
